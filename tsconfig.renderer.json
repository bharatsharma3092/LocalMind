{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./out/renderer",
    "rootDir": "./src/renderer",
    "declaration": true
  },
  "include": ["src/renderer/**/*"]
}
